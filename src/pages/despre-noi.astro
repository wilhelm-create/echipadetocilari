---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { business } from '../data/business';
import { organizationSchema, webPageSchema, breadcrumbSchema } from '../lib/schema';

const title = 'Despre noi';
const description =
  'Cine suntem: Echipa de Tocilari — tocilari de marketing și tehnologie care construiesc site-uri, SEO și campanii pentru afaceri din România.';

const schemas = [
  organizationSchema(),
  webPageSchema({
    path: '/despre-noi/',
    name: title,
    description,
    dateModified: new Date().toISOString().slice(0, 10),
  }),
  breadcrumbSchema([
    { name: 'Acasă', path: '/' },
    { name: 'Despre noi', path: '/despre-noi/' },
  ]),
];
---

<BaseLayout title={title} description={description} canonicalPath="/despre-noi/" schemas={schemas}>
  <section class="gradient-brand-soft section-pad">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow mb-2">Despre {business.name}</p>
        <h1 class="mb-4 text-4xl sm:text-5xl">Tocilari care fac marketing care funcționează</h1>
        <p class="mb-4 text-lg text-ink-soft">
          <strong class="text-ink">Răspuns scurt:</strong> suntem o agenție de marketing digital din
          România specializată în creare site web, SEO, mentenanță, PPC, logo și copywriting — cu
          mentalitate de „tocilar”: date, detalii, execuție.
        </p>
        <p class="text-ink-soft">
          {business.foundingNote}
        </p>
      </div>
      <img
        src="/images/About-Page-intro-pic.png"
        alt="Echipa de Tocilari — despre noi"
        width="640"
        height="640"
        class="mx-auto max-w-md rounded-2xl"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page max-w-3xl space-y-6">
      <h2 class="text-3xl">Ce credem</h2>
      <p class="text-ink-soft">
        Un site frumos care nu se încarcă pe 4G nu merită. SEO fără conținut util e zgomot. Ads
        fără landing page clară arde buget. De aceea legăm design, tehnologie și mesaj într-un
        sistem care servește un singur obiectiv: <strong>clienți pentru afacerea ta</strong>.
      </p>
      <h2 class="text-3xl">Cum lucrăm</h2>
      <ol class="list-decimal space-y-3 pl-5 text-ink-soft">
        <li>
          <strong class="text-ink">Descoperire</strong> — obiective, public, competiție, constrângeri
          de buget.
        </li>
        <li>
          <strong class="text-ink">Plan</strong> — priorități clare (site / SEO / ads / conținut), nu
          20 de canale deodată.
        </li>
        <li>
          <strong class="text-ink">Execuție</strong> — livrabile măsurabile, pe un calendar realist.
        </li>
        <li>
          <strong class="text-ink">Măsurare</strong> — raportare pe KPI (trafic, lead-uri, ranking,
          viteză).
        </li>
      </ol>
      <a href="/contact/#formular" class="btn-primary mt-4 inline-flex">Hai să ne cunoaștem</a>
    </div>
  </section>

  <ContactForm />
</BaseLayout>
