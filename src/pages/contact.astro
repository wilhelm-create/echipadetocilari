---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { business } from '../data/business';
import { organizationSchema, webPageSchema, breadcrumbSchema } from '../lib/schema';

const title = 'Contact';
const description =
  'Contactează Echipa de Tocilari pentru creare site, SEO sau mentenanță. Consultație gratuită de 30 de minute — răspundem din toată România.';

const schemas = [
  organizationSchema(),
  webPageSchema({ path: '/contact/', name: title, description }),
  breadcrumbSchema([
    { name: 'Acasă', path: '/' },
    { name: 'Contact', path: '/contact/' },
  ]),
];
---

<BaseLayout title={title} description={description} canonicalPath="/contact/" schemas={schemas}>
  <section class="section-pad gradient-brand-soft">
    <div class="container-page max-w-3xl text-center">
      <p class="eyebrow mb-2">Contact</p>
      <h1 class="mb-4 text-4xl sm:text-5xl">Hai să luăm legătura</h1>
      <p class="text-lg text-ink-soft">
        <strong class="text-ink">Te putem ajuta indiferent de orașul în care te afli.</strong>{' '}
        Lucrăm remote în {business.areaServed}. Scrie-ne proiectul — îți propunem pașii următori în
        consultația gratuită de 30 de minute.
      </p>
      <dl class="mx-auto mt-8 grid max-w-md gap-4 text-left sm:grid-cols-1">
        <div class="card-surface">
          <dt class="text-sm font-semibold text-muted">Email</dt>
          <dd>
            <a class="text-lg font-semibold text-brand-dark" href={`mailto:${business.email}`}>
              {business.email}
            </a>
          </dd>
        </div>
        <div class="card-surface">
          <dt class="text-sm font-semibold text-muted">Program</dt>
          <dd class="text-lg text-ink">{business.hours}</dd>
        </div>
        <div class="card-surface">
          <dt class="text-sm font-semibold text-muted">Zonă</dt>
          <dd class="text-lg text-ink">{business.areaServed} · online</dd>
        </div>
      </dl>
    </div>
  </section>
  <ContactForm compact />
</BaseLayout>
