---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { organizationSchema, webPageSchema, breadcrumbSchema } from '../lib/schema';

const title = 'Portofoliu web design';
const description =
  'Portofoliu Echipa de Tocilari: exemple de design web, template-uri și direcții vizuale pentru site-uri de prezentare și landing page.';

const schemas = [
  organizationSchema(),
  webPageSchema({ path: '/portofoliu/', name: title, description }),
  breadcrumbSchema([
    { name: 'Acasă', path: '/' },
    { name: 'Portofoliu', path: '/portofoliu/' },
  ]),
];
---

<BaseLayout title={title} description={description} canonicalPath="/portofoliu/" schemas={schemas}>
  <section class="section-pad gradient-brand-soft">
    <div class="container-page max-w-3xl text-center">
      <p class="eyebrow mb-2">Lucrări & direcții de design</p>
      <h1 class="mb-4 text-4xl sm:text-5xl">Portofoliu web design</h1>
      <p class="text-lg text-ink-soft">
        <strong class="text-ink">Ce vei găsi aici:</strong> direcții de design pe care le adaptăm
        brandului tău — de la layout-uri simple și elegante la structuri mai complexe. Fiecare
        proiect e personalizat; template-urile sunt punct de pornire, nu produs final copiat.
      </p>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page">
      <h2 class="mb-8 text-center text-3xl">Uite ce putem face pentru afacerea ta</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            { img: '/images/work-1024x707.png', label: 'Site-uri de prezentare' },
            { img: '/images/vr.webp', label: 'Experiențe interactive' },
            { img: '/images/character-4FKAQPE.png', label: 'Identitate vizuală' },
            { img: '/images/click.png', label: 'Landing pages de conversie' },
            { img: '/images/Tocilar-creare-site-web.webp', label: 'Web design custom' },
            { img: '/images/About-Page-intro-pic.png', label: 'Pagini despre brand' },
          ].map((item) => (
            <figure class="card-surface overflow-hidden !p-0">
              <img
                src={item.img}
                alt={item.label}
                width="640"
                height="480"
                class="aspect-[4/3] w-full object-cover"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="p-4 font-display text-lg text-ink">{item.label}</figcaption>
            </figure>
          ))
        }
      </div>
      <p class="mx-auto mt-10 max-w-2xl text-center text-ink-soft">
        Vrei un proiect similar, adaptat nișei tale? În consultația gratuită îți arătăm pașii și un
        interval realist de livrare.
      </p>
      <div class="mt-6 text-center">
        <a href="/contact/#formular" class="btn-primary">Discută proiectul tău</a>
      </div>
    </div>
  </section>

  <ContactForm />
</BaseLayout>
