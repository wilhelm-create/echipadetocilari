---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { business } from '../../data/business';
import { metaEn, testimonialsEn } from '../../i18n/content-en';
import { organizationSchema, webPageSchema, breadcrumbSchema } from '../../lib/schema';

const { title, description } = metaEn.clients;

const schemas = [
  organizationSchema('en'),
  webPageSchema({ path: '/en/clients/', name: title, description, locale: 'en' }),
  breadcrumbSchema([
    { name: 'Home', path: '/en/' },
    { name: 'Clients', path: '/en/clients/' },
  ]),
];
---

<BaseLayout title={title} description={description} canonicalPath="/en/clients/" schemas={schemas}>
  <section class="section-pad gradient-brand-soft">
    <div class="container-page max-w-3xl text-center">
      <p class="eyebrow mb-2">Glad they are here</p>
      <h1 class="mb-4 text-balance">Our clients</h1>
      <p class="text-lg text-ink-soft">
        <strong class="text-ink">Direct answer:</strong> we work with small and mid-sized businesses in
        Romania — veterinary clinics, restaurants, accommodation, online stores — building their
        websites, growing organic traffic, and running their campaigns.
      </p>
    </div>
  </section>

  <section class="section-pad" aria-labelledby="testimonials-heading">
    <div class="container-page">
      <p class="eyebrow mb-2 text-center">What they say about us</p>
      <h2 id="testimonials-heading" class="mb-10 text-center text-balance">
        Collaborations, in their own words
      </h2>

      <div class="grid gap-6 lg:grid-cols-3">
        {
          testimonialsEn.map((t, i) => (
            <figure
              class="card-surface flex h-full flex-col"
              data-animate="fade-up"
              data-stagger={String(i + 1)}
            >
              <span class="font-display text-5xl leading-none text-brand/40" aria-hidden="true">
                “
              </span>
              <blockquote class="mt-2 flex-1 text-ink-soft">
                <p>{t.quote}</p>
              </blockquote>
              <figcaption class="mt-5 border-t border-black/5 pt-4">
                <span class="block font-semibold text-ink">{t.name}</span>
                <span class="block text-sm text-muted">{t.role}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad bg-surface-2">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
      <div data-animate="fade-right">
        <h2 class="mb-4">How we work with our clients</h2>
        <p class="mb-4 text-ink-soft">
          We do not sell packages off a conveyor belt. We start from your business objective, propose
          a plan with an estimated budget, and then report what is working and what is not — with
          data, not promises.
        </p>
        <ul class="space-y-3 text-ink-soft">
          <li class="flex gap-3">
            <span class="mt-1 text-brand-dark" aria-hidden="true">1.</span>
            <span><strong class="text-ink">Free 30-minute consultation</strong> — we understand the business and the goal.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-1 text-brand-dark" aria-hidden="true">2.</span>
            <span><strong class="text-ink">A tailored plan</strong> — what we do, in what order, at what budget.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-1 text-brand-dark" aria-hidden="true">3.</span>
            <span><strong class="text-ink">Execution and reporting</strong> — we do the work and show you the results monthly.</span>
          </li>
        </ul>
      </div>

      <div class="card-surface text-center" data-animate="fade-left">
        <h2 class="mb-3 text-2xl text-brand-dark">Want to be next?</h2>
        <p class="mb-6 text-ink-soft">
          Tell us where you want your business to go online. The first conversation is free and
          without obligation.
        </p>
        <a href="/en/contact/#formular" class="btn-primary w-full sm:w-auto">
          Free 30-min consultation
        </a>
        <p class="mt-4 text-sm text-muted">
          or email us directly at{' '}
          <a class="font-semibold text-brand-dark underline" href={`mailto:${business.email}`}>
            {business.email}
          </a>
        </p>
      </div>
    </div>
  </section>

  <ContactForm />
</BaseLayout>
