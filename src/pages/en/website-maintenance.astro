---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { metaEn } from '../../i18n/content-en';
import {
  organizationSchema,
  webPageSchema,
  breadcrumbSchema,
  serviceSchema,
} from '../../lib/schema';

const { title, description } = metaEn.maintenance;

const included = [
  { name: 'Updates', body: 'Core, plugins, and themes kept current — the single most common cause of a hacked site is a version nobody updated.' },
  { name: 'Backups', body: 'Regular backups you can actually restore from, verified rather than assumed.' },
  { name: 'Security', body: 'Monitoring, hardening, and a plan for when something does go wrong.' },
  { name: 'Content changes', body: 'Text, images, prices, new pages — the edits you should not have to learn a CMS for.' },
  { name: 'Speed', body: 'Image optimisation, caching, and cleanup so the site does not get slower every month.' },
  { name: 'Uptime', body: 'We notice the site is down before your customers tell you.' },
];

const schemas = [
  organizationSchema('en'),
  webPageSchema({ path: '/en/website-maintenance/', name: title, description, locale: 'en' }),
  serviceSchema({
    name: 'Website maintenance',
    description,
    path: '/en/website-maintenance/',
    locale: 'en',
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/en/' },
    { name: 'Services', path: '/en/services/' },
    { name: 'Website maintenance', path: '/en/website-maintenance/' },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/en/website-maintenance/"
  schemas={schemas}
>
  <section class="section-pad gradient-brand-soft">
    <div class="container-page max-w-3xl text-center">
      <p class="eyebrow mb-2">Maintenance & support</p>
      <h1 class="mb-4 text-balance">Website maintenance</h1>
      <p class="text-lg text-ink-soft">
        <strong class="text-ink">Direct answer:</strong> we keep your website and online store updated,
        backed up, secure, and current — so it stays fast and safe without you thinking about it.
      </p>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page">
      <h2 class="mb-10 text-center">What maintenance covers</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          included.map((item, i) => (
            <article class="card-surface" data-animate="fade-up" data-stagger={String((i % 3) + 1)}>
              <h3 class="mb-2 font-display text-xl text-brand-dark">{item.name}</h3>
              <p class="text-sm leading-relaxed text-ink-soft">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad bg-surface-2">
    <div class="container-page max-w-3xl text-center" data-animate="zoom-in">
      <h2 class="mb-4 text-balance">
        A neglected website is a liability, not an asset
      </h2>
      <p class="text-lg text-ink-soft">
        Outdated software, expired certificates, and unnoticed downtime cost far more to fix than to
        prevent — and they cost you customers while they last.
      </p>
    </div>
  </section>

  <ContactForm />
</BaseLayout>
