---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { metaEn, servicesEn } from '../../i18n/content-en';
import { organizationSchema, webPageSchema, breadcrumbSchema } from '../../lib/schema';

const { title, description } = metaEn.services;

const schemas = [
  organizationSchema('en'),
  webPageSchema({ path: '/en/services/', name: title, description, locale: 'en' }),
  breadcrumbSchema([
    { name: 'Home', path: '/en/' },
    { name: 'Services', path: '/en/services/' },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/en/services/"
  schemas={schemas}
>
  <section class="section-pad gradient-brand-soft">
    <div class="container-page max-w-3xl text-center">
      <p class="eyebrow mb-2">What we do</p>
      <h1 class="mb-4 text-balance">Digital marketing services</h1>
      <p class="text-lg text-ink-soft">
        <strong class="text-ink">Direct answer:</strong> we cover the whole chain from website to traffic
        and conversion — web, SEO, ads, brand, and copy — so you are not juggling five suppliers who
        never talk to each other.
      </p>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page grid gap-6 sm:grid-cols-2">
      {
        servicesEn.map((s, i) => (
          <article
            id={s.slug}
            class="card-surface scroll-mt-28"
            data-animate="fade-up"
            data-stagger={String((i % 2) + 1)}
          >
            <h2 class="mb-2 text-2xl text-brand-dark">
              <a href={s.href} class="hover:underline">
                {s.title}
              </a>
            </h2>
            <p class="mb-3 text-ink-soft">{s.answer}</p>
            <p class="text-sm text-muted">{s.short}</p>
            <a
              href={s.href.includes('#') ? '/en/contact/#formular' : s.href}
              class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-brand-dark"
            >
              Details / quote →
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <ContactForm />
</BaseLayout>
