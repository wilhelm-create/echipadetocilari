---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { business } from '../../data/business';
import { metaEn } from '../../i18n/content-en';
import { organizationSchema, webPageSchema, breadcrumbSchema } from '../../lib/schema';

const { title, description } = metaEn.contact;

const schemas = [
  organizationSchema('en'),
  webPageSchema({ path: '/en/contact/', name: title, description, locale: 'en' }),
  breadcrumbSchema([
    { name: 'Home', path: '/en/' },
    { name: 'Contact', path: '/en/contact/' },
  ]),
];
---

<BaseLayout title={title} description={description} canonicalPath="/en/contact/" schemas={schemas}>
  <section class="section-pad gradient-brand-soft">
    <div class="container-page max-w-3xl text-center">
      <p class="eyebrow mb-2">Contact</p>
      <h1 class="mb-4 text-balance">Let's get in touch</h1>
      <p class="text-lg text-ink-soft">
        <strong class="text-ink">We can help wherever you are based.</strong> We work remotely across
        Romania and with clients abroad. Tell us about your project — you get the next steps in a free
        30-minute consultation.
      </p>
      <dl class="mx-auto mt-8 grid max-w-md gap-4 text-left">
        <div class="card-surface">
          <dt class="text-sm font-semibold text-muted">Email</dt>
          <dd>
            <a class="text-lg font-semibold text-brand-dark" href={`mailto:${business.email}`}>
              {business.email}
            </a>
          </dd>
        </div>
        <div class="card-surface">
          <dt class="text-sm font-semibold text-muted">Hours</dt>
          <dd class="text-lg text-ink">Monday–Sunday 09:00–17:00 (EET)</dd>
        </div>
        <div class="card-surface">
          <dt class="text-sm font-semibold text-muted">Based in</dt>
          <dd class="text-lg text-ink">
            {business.address.locality}, Romania · remote worldwide
          </dd>
        </div>
      </dl>
    </div>
  </section>
  <ContactForm compact />
</BaseLayout>
