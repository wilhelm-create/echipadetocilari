---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import {
  organizationSchema,
  webPageSchema,
  breadcrumbSchema,
  serviceSchema,
} from '../lib/schema';

const title = 'Administrare site & mentenanță';
const description =
  'Administrare site și magazin online: actualizări, securitate, backup și conținut. Mentenanță la nivel înalt — Echipa de Tocilari.';

const packs = [
  {
    name: 'Pachet Starter',
    items: ['Monitorizare uptime', 'Backup periodice', 'Actualizări de bază', 'Suport pe e-mail'],
  },
  {
    name: 'Pachet Premium',
    items: [
      'Tot din Starter',
      'Actualizări regulate CMS/plugin',
      'Patch-uri de securitate',
      'Ore incluse de conținut',
    ],
  },
  {
    name: 'Pachet Advanced',
    items: [
      'Tot din Premium',
      'Prioritate răspuns',
      'Mai multe ore de dezvoltare/conținut',
      'Raport lunar de sănătate',
    ],
  },
];

const schemas = [
  organizationSchema(),
  webPageSchema({ path: '/administrare-site/', name: title, description }),
  breadcrumbSchema([
    { name: 'Acasă', path: '/' },
    { name: 'Servicii', path: '/servicii/' },
    { name: 'Administrare site', path: '/administrare-site/' },
  ]),
  serviceSchema({
    name: 'Administrare site',
    description,
    path: '/administrare-site/',
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/administrare-site/"
  schemas={schemas}
  ogImage="/images/administrare-site-echipa-de-tocilari.webp"
>
  <section class="section-pad gradient-brand-soft">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow mb-2">Mentenanță la nivel înalt</p>
        <h1 class="mb-4">Administrare site & magazin online</h1>
        <p class="mb-4 text-lg text-ink-soft">
          <strong class="text-ink">Răspuns direct:</strong> preluăm actualizările, securitatea,
          backup-urile și grijile tehnice ale site-ului sau magazinului tău, ca tu să te concentrezi
          pe business.
        </p>
        <p class="mb-8 text-ink-soft">
          Un site cu conținut relevant și actualizat continuu rămâne un instrument de trafic și
          vânzări — nu un proiect abandonat după lansare.
        </p>
        <a href="/contact/#formular" class="btn-primary">Solicită pachet de administrare</a>
      </div>
      <img
        src="/images/administrare-site-echipa-de-tocilari.webp"
        alt="Administrare și mentenanță site web"
        width="800"
        height="600"
        class="rounded-2xl shadow-lg"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page">
      <h2 class="mb-3 text-center">Prețuri administrare</h2>
      <p class="mx-auto mb-10 max-w-2xl text-center text-ink-soft">
        Servicii lunare de administrare / mentenanță pentru site-uri web și magazine online.
        Detaliile se confirmă în ofertă personalizată.
      </p>
      <div class="grid gap-5 md:grid-cols-3">
        {
          packs.map((p) => (
            <article class="card-surface">
              <h3 class="mb-4 text-xl text-brand-dark">{p.name}</h3>
              <ul class="space-y-2 text-sm text-ink-soft">
                {p.items.map((item) => (
                  <li class="flex gap-2">
                    <span class="text-accent-green" aria-hidden="true">
                      ✓
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-muted">
        Pentru modificări de conținut sau funcționalități noi în afara pachetului, tariful orar
        orientativ este de <strong>30 € / oră</strong> (confirmat în contract).
      </p>
    </div>
  </section>

  <ContactForm />
</BaseLayout>
