---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import Lottie from '../components/Lottie.astro';
import { business, services, testimonials } from '../data/business';
import { homeFaqs } from '../data/faqs';
import {
  organizationSchema,
  websiteSchema,
  webPageSchema,
  faqSchema,
} from '../lib/schema';

const title = 'Agenție marketing digital & web design';
const description =
  'Echipa de Tocilari — agenție de marketing online din România: creare site web, SEO, mentenanță, PPC și copywriting. Consultație gratuită de 30 de minute.';

const schemas = [
  organizationSchema(),
  websiteSchema(),
  webPageSchema({
    path: '/',
    name: title,
    description,
    datePublished: '2024-02-15',
    dateModified: new Date().toISOString().slice(0, 10),
  }),
  faqSchema(homeFaqs),
];
---

<BaseLayout title={title} description={description} canonicalPath="/" schemas={schemas}>
  <!-- HERO -->
  <section class="relative overflow-hidden gradient-brand-soft">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background-image: url('/images/BG-HomePage-High.png'); background-size: cover; background-position: center;"
      aria-hidden="true"
    ></div>
    <div class="container-page relative grid items-center gap-10 py-14 sm:py-16 lg:grid-cols-2 lg:gap-12 lg:py-20">
      <div data-animate="fade-up">
        <p class="eyebrow mb-3">Agenție web design & marketing digital</p>
        <h1 class="mb-4 text-4xl leading-tight text-balance sm:text-5xl lg:text-[3.25rem]">
          Marketing online făcut de <span class="text-brand-dark">tocilari</span>!
        </h1>
        <p class="mb-4 max-w-xl text-lg text-ink-soft">
          Suntem nerdy, suntem pricepuți și suntem gata să-ți oferim soluțiile de marketing online
          de care afacerea ta are nevoie — site rapid, SEO care rankează și campanii care convertesc.
        </p>
        <p class="mb-8 max-w-xl text-base text-muted">
          <strong class="text-ink">Răspuns direct:</strong> {business.name} este agenția de
          marketing digital din România care construiește prezența online (web + SEO + ads) pentru
          afaceri care vor rezultate măsurabile, nu doar „prezență pe internet”.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="#formular" class="btn-primary anim-pulse-cta">
            Participă la o consultație <strong class="ml-1">GRATUITĂ</strong> de 30 min
          </a>
          <a href="/servicii/" class="btn-secondary">Vezi serviciile</a>
        </div>
      </div>
      <div
        class="relative mx-auto w-full max-w-md lg:max-w-none"
        data-animate="zoom-in"
        data-stagger="2"
      >
        <div class="anim-float">
          <img
            src="/images/Logo_Echipa_de_Tocilari-e1708028624694.webp"
            alt={`${business.name} — logo agenție marketing digital`}
            width="836"
            height="870"
            class="mx-auto h-auto w-full max-w-sm drop-shadow-2xl lg:max-w-md"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="pointer-events-none absolute -bottom-4 -right-2 w-28 sm:w-36 lg:w-44 opacity-90">
          <Lottie src="/lottie/services.json" label="Animație decorativă" aspect="1 / 1" />
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT STRIP -->
  <section class="section-pad" aria-labelledby="despre-heading">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2">
      <div data-animate="fade-left">
        <p class="eyebrow mb-2">Echipa de Tocilari</p>
        <h2 id="despre-heading" class="mb-4 text-3xl sm:text-4xl">Suntem aici pentru afacerea ta!</h2>
        <div class="space-y-4 text-ink-soft">
          <p>
            Suntem un grup de tocilari pasionați de marketing și tehnologie. Punem la dispoziția ta
            abilitățile noastre nerdy, ca să ajungi la publicul țintă și să te faci remarcat pe
            piața online.
          </p>
          <p>
            Ne pricepem la optimizare SEO, creare site web, social media marketing, PPC și
            copywriting — practic la aspectele de marketing digital pe care nu ai timp sau resurse
            să le faci singur.
          </p>
          <p>
            Suntem mereu la curent cu tendințele și tehnologiile din industrie, ca să-ți propunem
            soluții concrete, nu jargon.
          </p>
        </div>
        <a href="/despre-noi/" class="btn-secondary mt-8">Despre noi</a>
      </div>
      <div class="relative" data-animate="fade-right" data-stagger="2">
        <div class="absolute -inset-4 rounded-[2rem] bg-brand/10 blur-2xl anim-pulse-cta" aria-hidden="true"></div>
        <img
          src="/images/We-believe-BG.png"
          alt="Echipa de Tocilari — credem în muncă și dedicare"
          width="800"
          height="600"
          class="relative rounded-2xl shadow-lg"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section-pad bg-surface" aria-labelledby="servicii-heading">
    <div class="container-page">
      <div class="mx-auto mb-10 max-w-2xl text-center" data-animate="fade-up">
        <p class="eyebrow mb-2">Rezolvăm probleme reale</p>
        <h2 id="servicii-heading" class="text-3xl sm:text-4xl">Cum îți putem ajuta afacerea?</h2>
      </div>

      <div class="mb-10 mx-auto max-w-xs sm:max-w-sm" data-animate="zoom-in">
        <Lottie
          src="/lottie/hero.json"
          label="Animație marketing digital"
          aspect="1 / 1"
          class="drop-shadow-lg"
        />
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <a
              href={s.href}
              class="card-surface group block focus-visible:ring-2 focus-visible:ring-brand"
              data-animate="fade-up"
              data-stagger={String((i % 3) + 1)}
            >
              <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-2xl gradient-brand text-white shadow-brand anim-grow-icon">
                <span class="text-lg font-bold" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <h3 class="mb-2 font-display text-xl text-ink group-hover:text-brand-dark">{s.title}</h3>
              <p class="text-sm leading-relaxed text-ink-soft">{s.short}</p>
              <span class="mt-4 inline-flex items-center text-sm font-semibold text-brand-dark transition-transform group-hover:translate-x-1">
                Află mai mult →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="relative overflow-hidden py-16 text-white" data-animate="fade-up">
    <div class="absolute inset-0 anim-gradient" aria-hidden="true"></div>
    <div class="container-page relative text-center">
      <h2 class="mb-4 text-3xl text-white sm:text-4xl">
        Vorbește cu Echipa de Tocilari,<br class="hidden sm:block" />
        <span class="text-white/95">agenția ta de marketing digital</span>
      </h2>
      <a
        href="#formular"
        class="btn-secondary mt-4 !border-white !bg-white !text-brand-deeper anim-pulse-cta"
      >
        Consultație GRATUITĂ de 30 minute
      </a>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section
    class="section-pad relative"
    style="background-image: linear-gradient(rgba(252,252,252,.92), rgba(252,252,252,.96)), url('/images/BG-Testemonials-home-page.png'); background-size: cover;"
    aria-labelledby="testi-heading"
  >
    <div class="container-page">
      <div class="mx-auto mb-10 max-w-2xl text-center" data-animate="fade-up">
        <p class="eyebrow mb-2">Testimoniale</p>
        <h2 id="testi-heading" class="text-3xl sm:text-4xl">Ce spun clienții despre noi</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          testimonials.map((t, i) => (
            <blockquote
              class="card-surface flex h-full flex-col"
              data-animate="fade-up"
              data-stagger={String(i + 1)}
            >
              <p class="mb-6 flex-1 text-ink-soft leading-relaxed">“{t.quote}”</p>
              <footer>
                <cite class="not-italic">
                  <span class="block font-display text-lg text-ink">{t.name}</span>
                  <span class="text-sm text-muted">{t.role}</span>
                </cite>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </div>
  </section>

  <div data-animate="fade-up">
    <Faq items={homeFaqs} />
  </div>

  <!-- GEO / coverage -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl text-center" data-animate="zoom-in">
      <h2 class="mb-4 text-3xl sm:text-4xl text-balance">
        Te putem ajuta, indiferent de <span class="text-brand-dark">orașul</span> în care te afli
      </h2>
      <p class="text-lg text-ink-soft">
        Lucrăm remote în toată <strong>{business.areaServed}</strong>. Primul pas: o consultație
        gratuită de 30 de minute în care clarificăm obiective, buget și priorități.
      </p>
    </div>
  </section>

  <div data-animate="fade-up">
    <ContactForm id="formular" />
  </div>
</BaseLayout>
