---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import Lottie from '../components/Lottie.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import { business, homeServices, testimonials } from '../data/business';
import { homeFaqs } from '../data/faqs';
import {
  organizationSchema,
  websiteSchema,
  webPageSchema,
  faqSchema,
} from '../lib/schema';

const title = 'Agenție marketing digital & web design';
const description =
  'Echipa de Tocilari — agenție de marketing online din România: creare site web, SEO, mentenanță, PPC și copywriting. Consultație gratuită de 30 de minute.';

const schemas = [
  organizationSchema(),
  websiteSchema(),
  webPageSchema({
    path: '/',
    name: title,
    description,
    datePublished: '2024-02-15',
    dateModified: new Date().toISOString().slice(0, 10),
  }),
  faqSchema(homeFaqs),
];
---

<BaseLayout title={title} description={description} canonicalPath="/" schemas={schemas}>
  <!-- HERO — ported from the Elementor build: blobs background, text left,
       the big Lottie right, one paragraph, one outline CTA. -->
  <section class="hero-blobs relative overflow-hidden bg-white">
    <!-- Column widths, gap and vertical offsets are the measured Elementor values:
         397px text + 30px gap + 462px animation = 889px span. -->
    <div
      class="relative mx-auto flex w-full max-w-[889px] flex-col items-center gap-8 px-4 pb-12 pt-10 sm:px-6 lg:min-h-[780px] lg:flex-row lg:items-start lg:gap-[30px] lg:px-0 lg:pb-0 lg:pt-0"
    >
      <div
        class="order-2 w-full text-center lg:order-1 lg:w-[397px] lg:shrink-0 lg:pt-[175px] lg:text-left"
        data-animate-hero
      >
        <p class="eyebrow-hero mb-5">Agenție Web Design</p>
        <h1 class="mb-7">Marketing online făcut de tocilari!</h1>
        <p class="mb-7">
          Suntem nerdy, suntem pricepuți și suntem gata să-ți oferim soluțiile de marketing online
          de care afacerea ta are nevoie.
        </p>
        <a href="#formular" class="btn-secondary anim-pulse-cta">
          Participă la o consultație <strong class="mx-1">GRATUITĂ</strong> de 30 minute
        </a>
      </div>

      <div
        class="order-1 w-full max-w-[320px] sm:max-w-md lg:order-2 lg:mt-[194px] lg:w-[462px] lg:max-w-none"
        data-animate-hero="zoom"
      >
        <Lottie src="/lottie/hero.json" label="Animație marketing digital" aspect="1 / 1" />
      </div>
    </div>
  </section>

  <!-- ABOUT — Elementor puts the animation left and the copy right (580/634
       columns, 780px tall), with an orange h2 and a filled button. -->
  <section aria-labelledby="despre-heading">
    <div
      class="mx-auto flex w-full max-w-[1214px] flex-col items-center gap-10 px-4 py-14 sm:px-6 lg:min-h-[780px] lg:flex-row lg:items-start lg:gap-0 lg:px-0 lg:py-0"
    >
      <div class="w-full max-w-md lg:mt-[127px] lg:w-[580px] lg:max-w-none lg:shrink-0 lg:px-[10px]" data-animate="fade-left">
        <Lottie src="/lottie/services.json" label="Animație echipă marketing" aspect="560 / 525" />
      </div>

      <div class="w-full lg:mt-[93px] lg:w-[634px] lg:pl-[122px]" data-animate="fade-right" data-stagger="2">
        <p class="eyebrow mb-[20px] !text-[16px] !text-ink">ECHIPA DE TOCILARI</p>
        <h2 id="despre-heading" class="mb-[20px] text-brand">Suntem aici pentru afacerea ta!</h2>
        <div class="space-y-4 text-[16px] [&_p]:text-[16px] [&_p]:leading-[24px]">
          <p>
            Suntem un grup de tocilari pasionați de marketing și tehnologie. Punem la dispoziția ta
            abilitățile noastre nerdy, pentru a te ajuta să ajungi la publicul țintă și să te faci
            remarcat pe piața online.
          </p>
          <p>
            Cum te putem ajuta? Ei bine, ne pricepem la tot felul de tactici și strategii de
            marketing online – de la optimizarea motoarelor de căutare, la crearea site-ului web și
            social media marketing.
          </p>
          <p>
            Practic, noi ne ocupăm de toate aspectele de marketing digital pe care nu ai timp sau
            resurse să le faci singur. În plus, suntem mereu la curent cu cele mai noi tendințe și
            tehnologii din industrie, așa că te putem ghida prin lumea complicată a marketingului
            online și îți putem sugera cele mai bune soluții pentru afacerea ta.
          </p>
        </div>
        <a href="/despre-noi/" class="btn-primary mt-8">Despre noi</a>
      </div>
    </div>
  </section>

  <!-- SERVICES — the live homepage shows three boxes, not six: Logo Design,
       PPC and Copywriting sit in an `elementor-hidden-*` container there.
       Left-aligned heading, 294px columns, the original SVG icons. -->
  <section aria-labelledby="servicii-heading">
    <div class="mx-auto w-full max-w-[1150px] px-4 py-14 sm:px-6 lg:min-h-[640px] lg:px-0 lg:py-0">
      <div data-animate="fade-up">
        <p class="eyebrow mb-[10px]">Rezolvăm probleme reale</p>
        <h2 id="servicii-heading">Cum îți putem ajuta afacerea?</h2>
      </div>

      <div class="mt-10 grid gap-x-[108px] gap-y-10 sm:grid-cols-2 lg:mt-[149px] lg:grid-cols-3">
        {
          homeServices.map((s, i) => (
            <a
              href={s.href}
              class="group block max-w-[294px] focus-visible:outline-2 focus-visible:outline-brand"
              data-animate="fade-up"
              data-stagger={String(i + 1)}
            >
              <ServiceIcon name={s.icon} class="mb-5 anim-grow-icon" />
              <h3 class="mb-[10px] group-hover:text-brand-dark">{s.title}</h3>
              <p class="text-[16px] font-light leading-[22.4px]">{s.desc}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA BAND — heading left, button right, 215px tall (Elementor values). -->
  <section class="relative overflow-hidden text-white" data-animate="fade-up">
    <div class="absolute inset-0 anim-gradient" aria-hidden="true"></div>
    <div
      class="relative mx-auto flex w-full max-w-[1150px] flex-col items-center gap-6 px-4 py-12 text-center sm:px-6 lg:min-h-[215px] lg:flex-row lg:justify-between lg:gap-10 lg:px-0 lg:py-0 lg:text-left"
    >
      <h2 class="max-w-[571px] !text-[35px] !leading-[42px] text-white">
        Vorbește cu Echipa de Tocilari, agenția ta de marketing digital
      </h2>
      <a
        href="#formular"
        class="btn-secondary shrink-0 !border-white !bg-white !text-brand-deeper anim-pulse-cta"
      >
        Participă la o consultație <strong class="mx-1">GRATUITĂ</strong> de 30 minute
      </a>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section
    class="relative py-14 lg:py-0"
    style="background-image: linear-gradient(rgba(252,252,252,.92), rgba(252,252,252,.96)), url('/images/BG-Testemonials-home-page.png'); background-size: cover;"
    aria-labelledby="testi-heading"
  >
    <!-- Heading left (380px), carousel right (739px) — the Elementor layout. -->
    <div
      class="mx-auto flex w-full max-w-[1202px] flex-col gap-10 px-4 sm:px-6 lg:min-h-[545px] lg:flex-row lg:items-start lg:gap-10 lg:px-0"
    >
      <div class="lg:mt-[199px] lg:w-[380px] lg:shrink-0" data-animate="fade-up">
        <p class="eyebrow mb-[20px] !text-[16px]">Testimoniale</p>
        <h2 id="testi-heading">Ce spun clienții despre noi</h2>
      </div>

      <div class="lg:mt-[180px] lg:w-[739px]" data-animate="fade-up" data-stagger="2">
        <TestimonialCarousel items={testimonials} />
      </div>
    </div>
  </section>

  <div data-animate="fade-up">
    <Faq items={homeFaqs} />
  </div>

  <!-- COVERAGE + FORM — one band, as on the live site: white copy on the brand
       background at left, the form in a white 30px-radius card at right. -->
  <section id="formular" class="relative overflow-hidden" aria-labelledby="acoperire-heading">
    <div class="absolute inset-0 anim-gradient" aria-hidden="true"></div>
    <div
      class="relative mx-auto flex w-full max-w-[1150px] flex-col gap-10 px-4 py-14 sm:px-6 lg:min-h-[732px] lg:flex-row lg:items-start lg:gap-[60px] lg:px-0 lg:py-0"
    >
      <div class="lg:mt-[200px] lg:w-[477px] lg:shrink-0" data-animate="fade-right">
        <h2 id="acoperire-heading" class="!text-[42px] !font-normal !leading-[50.4px] text-white">
          Noi te putem ajuta, indiferent de orașul în care te afli.
        </h2>
        <p class="mt-10 !text-[22px] !leading-[26.4px] text-white">
          Ne-ar face mare plăcere să luăm legătura și să te ajutăm cu proiectul pe care îl ai!
        </p>
      </div>

      <div class="lg:mt-[130px] lg:w-[547px]" data-animate="fade-left" data-stagger="2">
        <ContactForm card />
      </div>
    </div>
  </section>
</BaseLayout>
