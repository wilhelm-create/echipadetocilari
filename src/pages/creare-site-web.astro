---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import { webFaqs } from '../data/faqs';
import {
  organizationSchema,
  webPageSchema,
  breadcrumbSchema,
  serviceSchema,
  faqSchema,
} from '../lib/schema';

const title = 'Creare site web';
const description =
  'Creare site web modern: landing page, site de prezentare sau magazin online. Design, UX, viteză și SEO de bază — Echipa de Tocilari.';

const types = [
  {
    title: '1. Landing page',
    body: 'O singură pagină de conversie, optimizată să atragă atenția și să convingă vizitatorul să acționeze (lead, apel, cumpărare). Ideală pentru campanii ads și oferte clare.',
  },
  {
    title: '2. Site de prezentare',
    body: '„Broșură digitală” multi-pagină care prezintă compania, serviciile și dovada socială. Structură clară, mobil-first și pregătită pentru SEO local / național.',
  },
  {
    title: '3. Magazin online',
    body: 'Platformă e-commerce pentru vânzare online: cataloage, coș, checkout, integrări plăți. Extinde piața dincolo de vânzările offline.',
  },
];

const schemas = [
  organizationSchema(),
  webPageSchema({ path: '/creare-site-web/', name: title, description }),
  breadcrumbSchema([
    { name: 'Acasă', path: '/' },
    { name: 'Servicii', path: '/servicii/' },
    { name: 'Creare site web', path: '/creare-site-web/' },
  ]),
  serviceSchema({
    name: 'Creare site web',
    description,
    path: '/creare-site-web/',
  }),
  faqSchema(webFaqs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/creare-site-web/"
  schemas={schemas}
  ogImage="/images/Tocilar-creare-site-web.webp"
>
  <section class="section-pad gradient-brand-soft">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2">
      <div data-animate="fade-left">
        <p class="eyebrow mb-2">Transformă viziunea digitală în realitate</p>
        <h1 class="mb-4 text-4xl sm:text-5xl">Creare site web</h1>
        <p class="mb-4 text-lg text-ink-soft">
          <strong class="text-ink">Răspuns direct:</strong> construim site-uri web personalizate —
          landing page, prezentare sau e-commerce — optimizate pentru mobil, viteză și conversie,
          cu SEO de bază integrat de la start.
        </p>
        <p class="mb-8 text-ink-soft">
          Vrei un site care te face să strălucești pe internet? Indiferent dacă promovezi o afacere,
          un brand sau un proiect personal, ne ocupăm de design, structură și tehnologie ca tu să
          te concentrezi pe clienți.
        </p>
        <a href="/contact/#formular" class="btn-primary anim-pulse-cta">Cere o ofertă gratuită</a>
      </div>
      <div class="anim-float" data-animate="zoom-in" data-stagger="2">
        <img
          src="/images/vr-768x905.webp"
          alt="Creare site web modern — Echipa de Tocilari"
          width="768"
          height="905"
          class="mx-auto max-h-[28rem] w-auto object-contain"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page">
      <h2 class="mb-3 text-center text-3xl sm:text-4xl" data-animate="fade-up">Prezența online contează</h2>
      <p class="mx-auto mb-10 max-w-2xl text-center text-ink-soft" data-animate="fade-up" data-stagger="2">
        Expertiza noastră, site-ul tău — fără stres. Alegem tipul de proiect după obiectivul real
        (lead-uri, brand, vânzări), nu după „ce e la modă”.
      </p>
      <div class="grid gap-6 md:grid-cols-3">
        {
          types.map((t, i) => (
            <article class="card-surface" data-animate="fade-up" data-stagger={String(i + 1)}>
              <h3 class="mb-3 text-xl text-brand-dark">{t.title}</h3>
              <p class="text-sm leading-relaxed text-ink-soft">{t.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad bg-surface">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 class="mb-4 text-3xl">Design și UX</h2>
        <p class="mb-4 text-ink-soft">
          Designul și experiența utilizatorului (UX) decid dacă vizitatorul rămâne sau pleacă în
          3 secunde. Construim ierarhie vizuală clară, CTA-uri vizibile pe mobil, formulare simple
          și navigare fără fricțiune.
        </p>
        <ul class="space-y-2 text-ink-soft">
          <li>✓ Mobile-first (viewport 320–428px mai întâi)</li>
          <li>✓ Performanță (LCP, imagini moderne, CSS minim)</li>
          <li>✓ SEO tehnic de bază (semantic HTML, meta, schema)</li>
          <li>✓ Accesibilitate (contrast, focus, label-uri)</li>
        </ul>
      </div>
      <img
        src="/images/work-1024x707.png"
        alt="Proces design și dezvoltare web"
        width="1024"
        height="707"
        class="rounded-2xl shadow-lg"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page max-w-3xl">
      <h2 class="mb-4 text-3xl">Cât costă un site?</h2>
      <p class="text-ink-soft">
        Prețul depinde de tipul de site, numărul de pagini și funcționalități. Oferta are caracter
        informativ și se personalizează după nevoi și buget. Contactează-ne pentru o estimare
        realistă — fără „preț unic” care nu se potrivește proiectului tău.
      </p>
    </div>
  </section>

  <Faq items={webFaqs} title="Întrebări despre creare site web" eyebrow="Ghid rapid" />
  <ContactForm />
</BaseLayout>
