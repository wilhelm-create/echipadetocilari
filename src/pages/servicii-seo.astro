---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import { seoFaqs } from '../data/faqs';
import {
  organizationSchema,
  webPageSchema,
  breadcrumbSchema,
  serviceSchema,
  faqSchema,
} from '../lib/schema';

const title = 'Servicii SEO';
const description =
  'Servicii SEO în România: audit, keywords, on-page, off-page și monitorizare. Creștem traficul organic și vizibilitatea pe Google — Echipa de Tocilari.';

const steps = [
  {
    t: '1. Audit optimizare SEO',
    d: 'Identificăm oportunități tehnice și de conținut, prioritizate după impact.',
  },
  {
    t: '2. Analiza pieței și a concurenței',
    d: 'Înțelegem unde stai acum și cum te diferențiezi eficient.',
  },
  {
    t: '3. Strategie keywords',
    d: 'Cercetare pe intenție de căutare — trafic calificat, nu doar volum.',
  },
  {
    t: '4. SEO on-page',
    d: 'Titluri, meta, structură, conținut și semnale de relevanță pe pagină.',
  },
  {
    t: '5. SEO off-page',
    d: 'Autoritate: mențiuni, linkuri de calitate și prezență de brand.',
  },
  {
    t: '6. Monitorizare campanie',
    d: 'KPI, ajustări pe date, raportare clară — fără „magie neagră”.',
  },
];

const packs = [
  {
    name: 'SEO Start-up',
    desc: 'Bază solidă pentru site-uri noi sau mici: audit, fix-uri prioritare, keywords core.',
  },
  {
    name: 'SEO Premium',
    desc: 'Creștere continuă: on-page + conținut + off-page, cu raportare lunară.',
  },
  {
    name: 'SEO Advanced',
    desc: 'Piețe competitive: strategie extinsă, conținut la scară, autoritate și tehnical deep-dive.',
  },
];

const schemas = [
  organizationSchema(),
  webPageSchema({ path: '/servicii-seo/', name: title, description }),
  breadcrumbSchema([
    { name: 'Acasă', path: '/' },
    { name: 'Servicii', path: '/servicii/' },
    { name: 'Servicii SEO', path: '/servicii-seo/' },
  ]),
  serviceSchema({ name: 'Servicii SEO', description, path: '/servicii-seo/' }),
  faqSchema(seoFaqs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/servicii-seo/"
  schemas={schemas}
  ogImage="/images/servicii-seo-boost-afacere.png"
>
  <section class="section-pad gradient-brand-soft">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2">
      <div data-animate="fade-left">
        <p class="eyebrow mb-2">Depășește-ți concurența</p>
        <h1 class="mb-4">Servicii SEO</h1>
        <p class="mb-4 text-lg text-ink-soft">
          <strong class="text-ink">Răspuns direct:</strong> serviciile SEO ale Echipei de Tocilari
          cresc vizibilitatea organică pe Google prin audit, strategie de keywords, optimizare
          on-page/off-page și monitorizare pe KPI — ca să transformi căutări în clienți.
        </p>
        <p class="mb-8 text-ink-soft">
          Convertim vizitatorii în clienți și maximizăm traficul pe site. Un impuls real pentru
          prezența online, fără dependență exclusivă de reclame plătite.
        </p>
        <a href="/contact/#formular" class="btn-primary anim-pulse-cta">Vorbește cu un specialist SEO</a>
      </div>
      <div class="anim-float" data-animate="fade-right" data-stagger="2">
        <img
          src="/images/servicii-seo-boost-afacere.png"
          alt="Boost afacere cu servicii SEO"
          width="800"
          height="600"
          class="rounded-2xl shadow-lg"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page max-w-3xl">
      <h2 class="mb-4">Pentru ce am nevoie de servicii SEO?</h2>
      <p class="text-ink-soft">
        Dacă deții o afacere sau un site, SEO te ajută să fii găsit când clienții caută exact ce
        oferi. Aproximativ jumătate din trafic poate veni din căutări organice pe multe piețe — SEO
        maximizează această felie ca să nu pierzi clienți potențiali. Rezultatele sunt pe termen
        lung și se acumulează, spre deosebire de ads care se opresc odată cu bugetul.
      </p>
    </div>
  </section>

  <section class="section-pad bg-surface">
    <div class="container-page">
      <h2 class="mb-8 text-center">Procesul nostru de optimizare SEO</h2>
      <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="card-surface" data-animate="fade-up" data-stagger={String((i % 3) + 1)}>
              <h3 class="mb-2 text-lg text-brand-dark">{s.t}</h3>
              <p class="text-sm text-ink-soft">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page">
      <h2 class="mb-3 text-center">Pachete orientative</h2>
      <p class="mx-auto mb-8 max-w-2xl text-center text-sm text-muted">
        Detaliile se personalizează după site, nișă și obiective. Minimum recomandat: 6 luni de
        continuitate pentru rezultate SEO serioase.
      </p>
      <div class="grid gap-5 md:grid-cols-3">
        {
          packs.map((p) => (
            <article class="card-surface border-t-4 border-t-brand">
              <h3 class="mb-2 text-xl">{p.name}</h3>
              <p class="text-sm text-ink-soft">{p.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Faq items={seoFaqs} title="Întrebări despre servicii SEO" eyebrow="SEO pe scurt" />
  <ContactForm />
</BaseLayout>
