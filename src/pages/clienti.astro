---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { business, testimonials } from '../data/business';
import { organizationSchema, webPageSchema, breadcrumbSchema } from '../lib/schema';

const title = 'Clienți & testimoniale';
const description =
  'Afaceri din România care lucrează cu Echipa de Tocilari — VetGO, Restaurant Conacu, Hostel Victoria. Ce spun despre colaborare, în cuvintele lor.';

const schemas = [
  organizationSchema(),
  webPageSchema({ path: '/clienti/', name: title, description }),
  breadcrumbSchema([
    { name: 'Acasă', path: '/' },
    { name: 'Clienți', path: '/clienti/' },
  ]),
];
---

<BaseLayout title={title} description={description} canonicalPath="/clienti/" schemas={schemas}>
  <section class="section-pad gradient-brand-soft">
    <div class="container-page max-w-3xl text-center">
      <p class="eyebrow mb-2">Ne bucurăm că sunt aici</p>
      <h1 class="mb-4 text-balance">Clienții noștri</h1>
      <p class="text-lg text-ink-soft">
        <strong class="text-ink">Răspuns direct:</strong> lucrăm cu afaceri mici și medii din România
        — cabinete veterinare, restaurante, unități de cazare, magazine online — cărora le construim
        site-uri, le creștem traficul organic și le administrăm campaniile.
      </p>
    </div>
  </section>

  <section class="section-pad" aria-labelledby="testimoniale-heading">
    <div class="container-page">
      <p class="eyebrow mb-2 text-center">Ce spun despre noi</p>
      <h2 id="testimoniale-heading" class="mb-10 text-center text-balance">
        Colaborări, în cuvintele lor
      </h2>

      <div class="grid gap-6 lg:grid-cols-3">
        {
          testimonials.map((t, i) => (
            <figure
              class="card-surface flex h-full flex-col"
              data-animate="fade-up"
              data-stagger={String(i + 1)}
            >
              <span class="font-display text-5xl leading-none text-brand/40" aria-hidden="true">
                “
              </span>
              <blockquote class="mt-2 flex-1 text-ink-soft">
                <p>{t.quote}</p>
              </blockquote>
              <figcaption class="mt-5 border-t border-black/5 pt-4">
                <span class="block font-semibold text-ink">{t.name}</span>
                <span class="block text-sm text-muted">{t.role}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad bg-surface-2">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
      <div data-animate="fade-right">
        <h2 class="mb-4">Cum lucrăm cu clienții noștri</h2>
        <p class="mb-4 text-ink-soft">
          Nu vindem pachete pe bandă. Pornim de la obiectivul afacerii tale, propunem un plan cu
          buget estimativ, iar apoi raportăm ce funcționează și ce nu — cu date, nu cu promisiuni.
        </p>
        <ul class="space-y-3 text-ink-soft">
          <li class="flex gap-3">
            <span class="mt-1 text-brand-dark" aria-hidden="true">1.</span>
            <span><strong class="text-ink">Consultație gratuită de 30 de minute</strong> — înțelegem afacerea și obiectivul.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-1 text-brand-dark" aria-hidden="true">2.</span>
            <span><strong class="text-ink">Plan personalizat</strong> — ce facem, în ce ordine, cu ce buget.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-1 text-brand-dark" aria-hidden="true">3.</span>
            <span><strong class="text-ink">Execuție și raportare</strong> — lucrăm și îți arătăm rezultatele lunar.</span>
          </li>
        </ul>
      </div>

      <div class="card-surface text-center" data-animate="fade-left">
        <h2 class="mb-3 text-2xl text-brand-dark">Vrei să fii următorul?</h2>
        <p class="mb-6 text-ink-soft">
          Spune-ne unde vrei să ajungă afacerea ta online. Prima discuție e gratuită și fără
          obligații.
        </p>
        <a href="/contact/#formular" class="btn-primary w-full sm:w-auto">
          Consultație gratuită de 30 min
        </a>
        <p class="mt-4 text-sm text-muted">
          sau scrie-ne direct la{' '}
          <a class="font-semibold text-brand-dark underline" href={`mailto:${business.email}`}>
            {business.email}
          </a>
        </p>
      </div>
    </div>
  </section>

  <ContactForm />
</BaseLayout>
