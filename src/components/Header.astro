---
import { business, nav } from '../data/business';
const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-black/5 bg-white/85 backdrop-blur-md supports-[backdrop-filter]:bg-white/75"
  style="padding-top: env(safe-area-inset-top)"
>
  <div class="container-page flex h-16 items-center justify-between gap-4 sm:h-[4.25rem]">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label={`${business.name} — acasă`}>
      <img
        src="/images/Logo_Echipa_de_Tocilari-e1708028624694.webp"
        alt={business.name}
        width="48"
        height="48"
        class="h-11 w-11 object-contain sm:h-12 sm:w-12"
        decoding="async"
      />
      <span class="hidden font-display text-base text-ink sm:block sm:text-lg">
        {business.name}
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigare principală">
      {
        nav.map((item) => {
          const active =
            item.href === '/'
              ? path === '/'
              : path === item.href || path.startsWith(item.href);
          if ('children' in item && item.children) {
            return (
              <div class="group relative">
                <a
                  href={item.href}
                  class:list={[
                    'inline-flex min-h-11 items-center rounded-full px-3 py-2 text-sm font-semibold transition-colors',
                    active ? 'text-brand-dark' : 'text-ink-soft hover:text-brand-dark',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                  <svg class="ml-1 h-3.5 w-3.5 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
                <div class="invisible absolute left-0 top-full z-20 min-w-[14rem] translate-y-1 rounded-xl border border-black/5 bg-white p-2 opacity-0 shadow-lg transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                  {item.children.map((c) => (
                    <a
                      href={c.href}
                      class="block rounded-lg px-3 py-2.5 text-sm font-medium text-ink-soft hover:bg-brand/10 hover:text-brand-dark"
                    >
                      {c.label}
                    </a>
                  ))}
                </div>
              </div>
            );
          }
          return (
            <a
              href={item.href}
              class:list={[
                'inline-flex min-h-11 items-center rounded-full px-3 py-2 text-sm font-semibold transition-colors',
                active ? 'text-brand-dark' : 'text-ink-soft hover:text-brand-dark',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/contact/#formular"
        class="btn-primary !min-h-10 !px-3 !py-2 text-xs sm:!min-h-11 sm:!px-5 sm:!py-2.5 sm:text-sm"
      >
        Consultație gratuită
      </a>

      <button
        type="button"
        id="menu-btn"
        class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-black/10 bg-white text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Deschide meniul"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-black/5 bg-white lg:hidden" hidden>
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Meniu mobil">
      {
        nav.flatMap((item) => {
          const links =
            'children' in item && item.children
              ? [item, ...item.children]
              : [item];
          return links.map((link) => (
            <a
              href={link.href}
              class="min-h-12 rounded-xl px-3 py-3 text-base font-semibold text-ink-soft hover:bg-brand/10 hover:text-brand-dark"
            >
              {link.label}
            </a>
          ));
        })
      }
      <a href="/contact/#formular" class="btn-primary mt-2 w-full">Consultație gratuită de 30 min</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = menu.hasAttribute('hidden');
      if (open) {
        menu.hidden = false;
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', 'Închide meniul');
      } else {
        menu.hidden = true;
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Deschide meniul');
      }
    });
  }
</script>
