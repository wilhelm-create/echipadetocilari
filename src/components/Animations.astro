---
/** Global scroll reveals + Lottie init. Loaded once in BaseLayout. */
---

<script>
  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initScrollReveal() {
    const els = document.querySelectorAll('[data-animate], .reveal');
    if (!els.length) return;

    if (prefersReducedMotion()) {
      els.forEach((el) => el.classList.add('is-inview'));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target;
          const delay = Number(el.getAttribute('data-delay') || 0);
          window.setTimeout(() => el.classList.add('is-inview'), delay);
          io.unobserve(el);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );

    els.forEach((el) => io.observe(el));
  }

  async function initLottie() {
    const hosts = document.querySelectorAll('[data-lottie]');
    if (!hosts.length || prefersReducedMotion()) return;

    const { default: lottie } = await import('lottie-web');

    hosts.forEach((host) => {
      const path = host.getAttribute('data-lottie');
      if (!path || host.getAttribute('data-lottie-ready') === '1') return;
      host.setAttribute('data-lottie-ready', '1');

      const loop = host.getAttribute('data-lottie-loop') !== 'false';
      const anim = lottie.loadAnimation({
        container: host,
        renderer: 'svg',
        loop,
        autoplay: true,
        path,
      });

      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) anim.play();
          else anim.pause();
        },
        { threshold: 0.05 }
      );
      io.observe(host);
    });
  }

  function init() {
    initScrollReveal();
    initLottie();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  document.addEventListener('astro:page-load', init);
</script>
