---
/**
 * Footer ported from the Elementor build: white background with ink text
 * (not the dark slab the Astro redesign used), three columns — logo, company
 * details, important pages — then a bottom row with socials and the copyright.
 */
import { business } from '../data/business';
import { getLocale, localizedPath, routes } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { RouteKey } from '../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const s = t(locale);
const year = new Date().getFullYear();

const importantKeys: RouteKey[] = ['web', 'seo', 'maintenance', 'contact'];
const importantLinks = importantKeys.map((k) => ({
  href: localizedPath(k, locale),
  label: s.routeLabels[k],
}));

const heading = locale === 'en' ? 'IMPORTANT PAGES' : 'PAGINI IMPORTANTE';
const followUs = locale === 'en' ? 'Follow us:' : 'Urmărește-ne pe:';
const rights = locale === 'en' ? 'All Rights Reserved' : 'Toate drepturile rezervate';
const addressLabel = locale === 'en' ? 'Address' : 'Adresa';
---

<footer class="border-t border-black/5 bg-white text-ink">
  <div class="mx-auto w-full max-w-[1214px] px-4 py-10 sm:px-6 lg:min-h-[355px] lg:px-0 lg:py-[60px]">
    <div class="grid gap-8 lg:grid-cols-[348px_396px_396px] lg:gap-6">
      <div class="flex items-start">
        <a href={routes.home[locale]} aria-label={`${business.name} — ${s.homeAria}`}>
          <img
            src="/images/Logo_Echipa_de_Tocilari-e1708028624694.webp"
            alt={business.name}
            width="120"
            height="125"
            class="h-auto w-[120px] object-contain"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>

      <div class="text-[16px] leading-[27.2px]">
        <p class="font-semibold">{business.legalName}</p>
        <p>
          {addressLabel}: {business.address.street},<br />
          {business.address.locality}, {business.address.postalCode}, {
            locale === 'en' ? 'Romania' : 'România'
          }
        </p>
        <p>
          site: <a class="hover:text-brand" href={routes.home[locale]}>echipadetocilari.ro</a>
        </p>
        <p>
          email: <a class="hover:text-brand" href={`mailto:${business.email}`}>{business.email}</a>
        </p>
        <p>CUI: {business.vatId.replace(/^RO/, '')} | {business.registrationNumber}</p>
      </div>

      <div class="text-[16px] leading-[32px]">
        <p class="font-semibold">{heading}</p>
        <ul>
          {
            importantLinks.map((l) => (
              <li>
                <a href={l.href} class="transition-colors hover:text-brand">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-4 border-t border-black/5 pt-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex items-center gap-4">
        <span class="text-[16px] leading-[19.2px]">{followUs}</span>
        <ul class="flex items-center gap-3">
          <li>
            <a
              href="https://www.facebook.com/EchipadeTocilari/"
              class="inline-flex h-10 w-10 items-center justify-center text-ink transition-colors hover:text-brand"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <svg class="h-5 w-5" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
                <path
                  d="M400 32H48A48 48 0 0 0 0 80v352a48 48 0 0 0 48 48h137.25V327.69h-63V256h63v-54.64c0-62.15 37-96.48 93.67-96.48 27.14 0 55.52 4.84 55.52 4.84v61h-31.27c-30.81 0-40.42 19.12-40.42 38.73V256h68.78l-11 71.69h-57.78V480H400a48 48 0 0 0 48-48V80a48 48 0 0 0-48-48z"
                ></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/company/echipa-de-tocilari/"
              class="inline-flex h-10 w-10 items-center justify-center text-ink transition-colors hover:text-brand"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
            >
              <svg class="h-5 w-5" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
                <path
                  d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"
                ></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <p class="text-[14px] leading-[16.8px]">© {year} {rights}</p>
    </div>
  </div>
</footer>
