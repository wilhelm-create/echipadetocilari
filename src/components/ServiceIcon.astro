---
/**
 * Inlines one of the original Elementor service icons.
 *
 * The SVGs carry no `fill` — they inherit `currentColor`, exactly as they did
 * on the live site — so they must be inlined rather than loaded via <img>,
 * otherwise they render black.
 */
import creareSiteWeb from '../icons/creare-site-web.svg?raw';
import optimizareSeo from '../icons/optimizare-seo.svg?raw';
import mentenanta from '../icons/mentenanta.svg?raw';

const icons: Record<string, string> = {
  'creare-site-web': creareSiteWeb,
  'optimizare-seo': optimizareSeo,
  mentenanta,
};

interface Props {
  name: string;
  class?: string;
}
const { name, class: className = '' } = Astro.props;

// 65px is the rendered size on the live site.
const svg = (icons[name] ?? '').replace(
  /<svg([^>]*)>/,
  '<svg$1 width="65" height="65" aria-hidden="true" focusable="false">'
);
---

<!-- `fill-current` reproduces Elementor's `.elementor-icon svg { fill: currentColor }`;
     without it the paths fall back to SVG's default black. -->
<span
  class:list={[
    'inline-block text-brand [&_svg]:h-[65px] [&_svg]:w-[65px] [&_svg]:fill-current',
    className,
  ]}
  set:html={svg}
/>
