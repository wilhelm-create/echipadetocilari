---
import { getLocale, routes } from '../i18n/routes';
import { t } from '../i18n/ui';

const locale = getLocale(Astro.url.pathname);
const s = t(locale);
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-black/10 bg-white/95 px-3 py-2 shadow-[0_-8px_30px_rgba(0,0,0,0.08)] backdrop-blur md:hidden"
  style="padding-bottom: max(0.5rem, env(safe-area-inset-bottom))"
>
  <a href={`${routes.contact[locale]}#formular`} class="btn-primary w-full !min-h-12 text-sm">
    {s.ctaSticky}
  </a>
</div>
