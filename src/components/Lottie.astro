---
interface Props {
  src: string;
  class?: string;
  label?: string;
  loop?: boolean;
  /** intrinsic aspect for CLS — default square-ish */
  aspect?: string;
}

const {
  src,
  class: className = '',
  label = 'Animație decorativă',
  loop = true,
  aspect = '1 / 1',
} = Astro.props;
---

<div
  class:list={['lottie-host', className]}
  data-lottie={src}
  data-lottie-loop={loop ? 'true' : 'false'}
  role="img"
  aria-label={label}
  style={`aspect-ratio: ${aspect};`}
>
</div>
