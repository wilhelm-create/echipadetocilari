---
import type { FaqItem } from '../data/faqs';
import { getLocale } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  items: FaqItem[];
  title?: string;
  eyebrow?: string;
  id?: string;
}

const defaults = t(getLocale(Astro.url.pathname)).faq;
const {
  items,
  title = defaults.heading,
  eyebrow = defaults.eyebrow,
  id = 'faq',
} = Astro.props;
---

<section id={id} class="section-pad bg-surface-2" aria-labelledby={`${id}-heading`}>
  <div class="container-page max-w-3xl">
    <p class="eyebrow mb-2 text-center">{eyebrow}</p>
    <h2 id={`${id}-heading`} class="mb-8 text-center text-balance">
      {title}
    </h2>

    <div class="space-y-3">
      {
        items.map((item, i) => (
          <details
            class="group card-surface !p-0 overflow-hidden open:shadow-brand/10"
            name="faq"
            open={i === 0}
            data-animate="fade-up"
            data-stagger={String(Math.min(i + 1, 6))}
          >
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-4 text-left font-display text-lg text-ink marker:content-none sm:px-6 sm:py-5 sm:text-xl [&::-webkit-details-marker]:hidden">
              <span>{item.question}</span>
              <span
                class="mt-1 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand/15 text-brand-dark transition group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            {/* Answer always in DOM (even when closed browsers keep content) for AEO scrapers */}
            <div class="border-t border-black/5 px-5 pb-5 pt-3 text-base leading-relaxed text-ink-soft sm:px-6 sm:pb-6">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
