---
import { alternatePath, getLocale, routes, getRouteKey } from '../i18n/routes';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const path = Astro.url.pathname;
const locale = getLocale(path);
const key = getRouteKey(path);

// On a page with no counterpart (a 404, say) both links still resolve — to home.
const roHref = key ? routes[key].ro : alternatePath(path, 'ro');
const enHref = key ? routes[key].en : alternatePath(path, 'en');
---

<nav
  class:list={[
    'inline-flex shrink-0 items-center overflow-hidden rounded-full border-2 border-brand bg-white',
    className,
  ]}
  aria-label="Language"
>
  <a
    href={roHref}
    hreflang="ro"
    lang="ro"
    aria-current={locale === 'ro' ? 'true' : undefined}
    class:list={[
      'inline-flex min-h-9 min-w-10 items-center justify-center px-2.5 text-xs font-bold tracking-wide transition',
      locale === 'ro' ? 'bg-brand text-white' : 'text-brand-dark hover:bg-brand/10',
    ]}
  >
    RO
  </a>
  <a
    href={enHref}
    hreflang="en"
    lang="en"
    aria-current={locale === 'en' ? 'true' : undefined}
    class:list={[
      'inline-flex min-h-9 min-w-10 items-center justify-center border-l border-brand/35 px-2.5 text-xs font-bold tracking-wide transition',
      locale === 'en' ? 'bg-brand text-white' : 'text-brand-dark hover:bg-brand/10',
    ]}
  >
    EN
  </a>
</nav>
