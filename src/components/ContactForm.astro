---
import { business } from '../data/business';
import { getLocale } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  id?: string;
  compact?: boolean;
  /** Bare white card, no section wrapper — used inside the homepage coverage band. */
  card?: boolean;
}
const { id = 'formular', compact = false, card = false } = Astro.props;

const locale = getLocale(Astro.url.pathname);
const f = t(locale).form;

const field =
  'min-h-12 w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-ink outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/30';
---

<Fragment>
  <!-- Three shapes: full section (default), compact (contact page), and a bare
       card that sits inside another section. -->
  <section
    id={card ? undefined : id}
    class:list={[
      card ? 'contents' : 'section-pad',
      !card && (compact ? 'bg-white' : 'gradient-brand-soft'),
    ]}
  >
  <div class:list={[card ? 'contents' : 'container-page']}>
    <div
      class:list={[
        card
          ? 'rounded-[30px] bg-white p-8 shadow-[0_8px_30px_rgb(0,0,0,0.06)] sm:p-10'
          : 'mx-auto max-w-2xl',
        !card && !compact && 'card-surface sm:p-10',
      ]}
    >
      {
        card ? (
          <h2 class="mb-6 !text-[22px] !font-semibold !leading-[26.4px] !text-ink">{f.eyebrow}</h2>
        ) : (
          <>
            <p class="eyebrow mb-2">{f.eyebrow}</p>
            <h2 class="mb-2">{f.heading}</h2>
            <p class="mb-8 text-ink-soft">{f.intro}</p>
          </>
        )
      }

      {/* formsubmit.co: no backend needed on a static host. Recipient is business.email. */}
      <form class="grid gap-4" method="POST" action={`https://formsubmit.co/${business.email}`}>
        <input type="hidden" name="_subject" value={f.subject} />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_language" value={locale === 'en' ? 'en' : 'ro'} />
        <input
          type="text"
          name="_honey"
          class="hidden"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="mb-1.5 block text-sm font-semibold text-ink">{f.name} *</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class={field}
              placeholder={f.namePlaceholder}
            />
          </label>
          <label class="block">
            <span class="mb-1.5 block text-sm font-semibold text-ink">{f.email} *</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              inputmode="email"
              class={field}
              placeholder={f.emailPlaceholder}
            />
          </label>
        </div>

        {/* The homepage card mirrors the live form: name, email, message only. */}
        {
          !card && (
            <>
              <label class="block">
                <span class="mb-1.5 block text-sm font-semibold text-ink">{f.phone}</span>
                <input
                  type="tel"
                  name="phone"
                  autocomplete="tel"
                  inputmode="tel"
                  class={field}
                  placeholder={f.phonePlaceholder}
                />
              </label>

              <label class="block">
                <span class="mb-1.5 block text-sm font-semibold text-ink">{f.service}</span>
                <select name="service" class={field}>
                  <option value="">{f.servicePlaceholder}</option>
                  {f.serviceOptions.map((o) => (
                    <option>{o}</option>
                  ))}
                </select>
              </label>
            </>
          )
        }

        <label class="block">
          <span class="mb-1.5 block text-sm font-semibold text-ink">{f.message} *</span>
          <textarea
            name="message"
            required
            rows="5"
            class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-ink outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/30"
            placeholder={f.messagePlaceholder}></textarea>
        </label>

        <button type="submit" class="btn-primary w-full sm:w-auto">{f.submit}</button>

        <p class="text-xs text-muted">
          {f.consent}{' '}
          <a class="font-semibold text-brand-dark underline" href={`mailto:${business.email}`}>
            {business.email}
          </a>
        </p>
      </form>
    </div>
  </div>
  </section>
</Fragment>
